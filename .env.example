# Copy this file to .env and fill in real values. .env is never committed.
APP_NAME=flutterfix
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json
DATABASE_URL=postgresql://user:password@localhost:5432/flutterfix

# LLM keys (Day 8). Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Real values go in .env, GitHub Secrets and Render only. Never in Git.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Redis & Background Ingestion (Day 10)
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=change-me-to-a-secure-token
WORKER_IN_API=false
INGEST_CONCURRENCY=2
INGEST_RPM=12.0
INGEST_JOB_TIMEOUT=60
INGEST_MAX_TRIES=3
